# --- AI API Keys (Add any keys you have, it will automatically fallback) ---
# 1. Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. xAI Grok (https://console.x.ai/)
GROK_API_KEY=your_grok_api_key_here

# 3. Moonshot Kimi (https://platform.moonshot.cn/)
KIMI_API_KEY=your_kimi_api_key_here

# 4. Alibaba Qwen (https://dashscope.aliyun.com/ or https://openrouter.ai/)
QWEN_API_KEY=your_qwen_api_key_here

# 5. Optional Custom OpenAI-compatible Provider (DeepSeek / Local Ollama / OpenRouter)
CUSTOM_AI_API_KEY=your_custom_ai_key_here
CUSTOM_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# --- Telegram Bot Config ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Optional Gmail OAuth Config ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
